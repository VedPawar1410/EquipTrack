# Copy to .env for running uvicorn directly on your machine (outside Docker):
#   cp .env.example .env
#   docker compose up -d postgres liquibase   # DB + migrations only
#   uvicorn app.main:app --reload
# Inside docker compose, DATABASE_URL is set in docker-compose.yml instead.

# The app uses SQLAlchemy's async engine (asyncpg). A hosted URL can be pasted as given
# (e.g. Neon's postgresql://...?sslmode=require): it is converted to +asyncpg and ssl=require at startup.
DATABASE_URL=postgresql+asyncpg://equiptrack:devpassword@localhost:5433/equiptrack

# Signs login tokens. Required, min 32 chars. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Log every SQL statement (noisy; handy when debugging queries)
SQL_ECHO=false

# Documents / RAG
MAX_UPLOAD_MB=10
# fastembed = real local model (~320 MiB RAM at peak). hashing = deterministic fake (tests only).
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLMs (free tiers), tried in this order; leave both blank to answer with manual excerpts only.
LLM_ORDER=groq,gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# A chunk without an exact code match must be at least this similar to count as relevant.
RAG_MIN_SIMILARITY=0.55
# Per user, across /ai/ask and /ai/diagnose (protects the free LLM quotas on a public demo).
AI_REQUESTS_PER_HOUR=30

# Only read by `python -m app.seed_demo`: gives the admin demo account a private password
# instead of the published one. Set it whenever you seed a public deployment.
DEMO_ADMIN_PASSWORD=
