# Copy to .env for running uvicorn directly on your machine (outside Docker):
#   cp .env.example .env
#   docker compose up -d postgres liquibase   # DB + migrations only
#   uvicorn app.main:app --reload
# Inside docker compose, DATABASE_URL is set in docker-compose.yml instead.

# Must use the +asyncpg driver: the app uses SQLAlchemy's async engine.
DATABASE_URL=postgresql+asyncpg://equiptrack:devpassword@localhost:5433/equiptrack

# Log every SQL statement (noisy; handy when debugging queries)
SQL_ECHO=false
