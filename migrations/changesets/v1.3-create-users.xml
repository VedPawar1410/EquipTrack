<?xml version="1.0" encoding="UTF-8"?>
<!--
  v1.3: authentication.
  - New users table (createTable is release-safe: old code never references it).
  - Expand step of "expand / contract": NEW nullable *_id columns pointing at users, next to the
    existing free-text name columns. Nothing is renamed, retyped or wiped, so code that only
    knows performed_by / reported_by / assigned_to keeps working while the new code fills both.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
    logicalFilePath="changesets/v1.3-create-users.xml">

    <changeSet id="1.3.1-create-users" author="ved">
        <createTable tableName="users">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="users_username_unique"/>
            </column>
            <column name="email" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="users_email_unique"/>
            </column>
            <column name="hashed_password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(20)" defaultValue="technician">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <!-- Roles are validated in the API too; the CHECK guarantees nothing else can write a bad one. -->
        <sql>ALTER TABLE users ADD CONSTRAINT users_role_check CHECK (role IN ('technician', 'supervisor', 'admin'));</sql>
        <createIndex tableName="users" indexName="idx_users_role"><column name="role"/></createIndex>
        <rollback>
            <dropTable tableName="users"/>
        </rollback>
    </changeSet>

    <changeSet id="1.3.2-maintenance-performed-by-id" author="ved">
        <comment>Which account logged the work. ON DELETE SET NULL: history outlives accounts.</comment>
        <addColumn tableName="maintenance_logs">
            <column name="performed_by_id" type="UUID"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="maintenance_logs" baseColumnNames="performed_by_id"
                                 constraintName="fk_maintenance_performed_by_id"
                                 referencedTableName="users" referencedColumnNames="id" onDelete="SET NULL"/>
        <createIndex tableName="maintenance_logs" indexName="idx_maintenance_performed_by_id"><column name="performed_by_id"/></createIndex>
        <rollback>
            <dropColumn tableName="maintenance_logs" columnName="performed_by_id"/>
        </rollback>
    </changeSet>

    <changeSet id="1.3.3-issues-user-ids" author="ved">
        <comment>Who reported / is assigned the issue, as real user references.</comment>
        <addColumn tableName="issues">
            <column name="reported_by_id" type="UUID"/>
            <column name="assigned_to_id" type="UUID"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="issues" baseColumnNames="reported_by_id"
                                 constraintName="fk_issues_reported_by_id"
                                 referencedTableName="users" referencedColumnNames="id" onDelete="SET NULL"/>
        <addForeignKeyConstraint baseTableName="issues" baseColumnNames="assigned_to_id"
                                 constraintName="fk_issues_assigned_to_id"
                                 referencedTableName="users" referencedColumnNames="id" onDelete="SET NULL"/>
        <createIndex tableName="issues" indexName="idx_issues_assigned_to_id"><column name="assigned_to_id"/></createIndex>
        <rollback>
            <dropColumn tableName="issues" columnName="assigned_to_id"/>
            <dropColumn tableName="issues" columnName="reported_by_id"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
